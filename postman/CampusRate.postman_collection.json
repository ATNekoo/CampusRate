          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () {\n    pm.response.to.have.status(400);\n});",
              "pm.test('Problem Details format', function () {\n    const body = pm.response.json();\n    pm.expect(body).to.have.property('type');\n    pm.expect(body).to.have.property('status', 400);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
