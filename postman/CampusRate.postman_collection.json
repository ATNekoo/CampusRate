          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404', function () {\n    pm.response.to.have.status(404);\n});",
              "pm.test('Problem Details format', function () {\n    pm.expect(pm.response.json().status).to.equal(404);\n});"
            ]
          }
        }
