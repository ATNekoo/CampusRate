    {
      "name": "Get place avec pagination",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {\n    pm.response.to.have.status(200);\n});",
              "pm.test('Response has data and pagination', function () {\n    const body = pm.response.json();\n    pm.expect(body).to.have.property('data');\n    pm.expect(body).to.have.property('pagination');\n    pm.expect(body.pagination.page).to.equal(1);\n    pm.expect(body.pagination.limit).to.equal(5);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/places?category=LIBRARY&page=1&limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "places"
          ],
          "query": [
            {
              "key": "category",
              "value": "LIBRARY"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
